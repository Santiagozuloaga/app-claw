# Normaliza el texto a LF en el índice: evita diffs falsos entre quien trabaja con CRLF (Windows)
# y el repositorio, que está en LF. Los binarios quedan intactos.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.png binary
*.jpg binary
*.zip binary
*.jar binary
*.aar binary
*.pyc binary
*.bin binary
*.lock binary
